# Cloudflare Pages rewrites (status 200 = serve this file, keep the address).
# See hosting/README.md. Party links: every /p/<id> gets the same static page.
/p/*  /p/index.html  200
# Invite links: /i#<token>. The fragment never reaches the server, so the
# request path is exactly /i (or /i/).
/i    /i/index.html  200
