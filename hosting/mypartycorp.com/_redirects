# Cloudflare Pages rewrites (status 200 = serve this file, keep the address).
# See hosting/README.md. Party links: every /p/<id> gets the same static page.
/p/*  /p/index.html  200
# Invite links: /i#<token>. The fragment never reaches the server, so the
# request path is exactly /i (or /i/).
/i    /i/index.html  200
# Auth email links (Phase 47). GoTrue redirects the browser to these after it
# has checked the email token; the pages are static and read nothing.
/auth/reset         /auth/reset/index.html         200
/auth/email-change  /auth/email-change/index.html  200
