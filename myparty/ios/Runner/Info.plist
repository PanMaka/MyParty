<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Myparty</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>myparty</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Phase 5: image_picker. Without these two strings iOS terminates the
	     app the moment the story picker opens, rather than refusing politely. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Για να ανεβάσεις φωτογραφία στο story του πάρτι.</string>
	<key>NSCameraUsageDescription</key>
	<string>Για να τραβήξεις φωτογραφία για το story του πάρτι.</string>

	<!-- Phase 7c. Missing here until now, which meant the map's existing
	     Geolocator call was already relying on a string iOS requires: without
	     it the app is terminated the instant location is requested.

	     The wording matters more than usual. iOS shows this string verbatim in
	     the permission dialog and Apple rejects builds whose purpose strings are
	     vague, so it names what is stored (an approximate area) rather than
	     "your location" — and the full explanation the user actually reads is
	     the in-app sheet shown BEFORE this dialog ever appears. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Για να σου δείχνουμε πάρτι κοντά σου. Αποθηκεύουμε μόνο μια περιοχή ~100μ, που σβήνεται μετά από 24 ώρες.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Για να σε ειδοποιούμε όταν ανοίγει πάρτι κοντά σου, ακόμη κι όταν η εφαρμογή είναι κλειστή. Αποθηκεύουμε μόνο μια περιοχή ~100μ, που σβήνεται μετά από 24 ώρες.</string>

	<!-- `remote-notification` lets a data-only push wake the app; `location`
	     is what allows position updates to continue in the background, which is
	     the whole point of a proximity feature that fires while the phone is in
	     a pocket. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>location</string>
	</array>
</dict>
</plist>
