# Copy to `.env` (git-ignored) and fill in. Bundled into the app as an asset by
# flutter_dotenv, so every value here ships inside the build: nothing secret
# beyond a client key belongs in it.

# Supabase. Locally: `supabase status`; from an Android emulator use
# http://10.0.2.2:54321 (10.0.2.2 is the host's loopback).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Map tiles (CARTO dark_all). map_base.dart.
CARTO_API_KEY=

# Address search in the host wizard (MapTiler Geocoding API only; the tiles
# stay CARTO's). geocoding_service.dart. Without it, search reports
# "unavailable" and hosts place the pin by hand.
MAPTILER_API_KEY=
